
pipeline {
    agent {
        docker {
            image 'maven:3.9-eclipse-temurin-17'
        }
    }

    stages {
        stage('Check Tools') {
            steps {
                sh 'java -version'
                sh 'mvn -version'
            }
        }

        stage('Build') {
            steps {
                dir('maven-jenkins') {
                    sh 'mvn clean package'
                }
            }
        }
    }

    post {
        success {
            echo 'Maven build successful!'
        }
        failure {
            echo 'Build failed. Check Console Output.'
        }
    }
}

